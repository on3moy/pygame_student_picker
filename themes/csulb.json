      "Orbitron",
      "Rajdhani",
      "Bahnschrift",
      "Agency FB",
      "Consolas",
      "DejaVu Sans Mono",
      "monospace"
    ],
    "name_size": 50,
    "small_size": 14,
    "bold": true,
    "uppercase": true,
    "fill": 0.94
  },
  "colors": {
    "bg_top": [
      43,
      45,
      49
    ],
    "bg_bottom": [
      24,
      25,
      28
    ],
    "border": [
      232,
      117,
      42
    ],
    "border_flash": [
      255,
      172,
      102
    ],
    "name": [
      242,
